# 取消忽略本项目下的 scripts/temp 目录（父级 .gitignore 中 temp/ 规则会忽略它）
!scripts/temp/
temp/

# 运行时产物与依赖，不进版本库
node_modules/
scripts/task-results/
scripts/uploads/
*.log
scripts/task_records.jsonl
.vscode/settings.json

# 改造前的本地备份（改 SKILL.md / references 大文档前自动生成），不进版本库
_backup/
scripts/.skill-cost-history.jsonl
# 授权文件与试用计数（运行时生成，不进版本库）
license-key.txt
.cache_*
